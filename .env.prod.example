# Production environment variables.
#
# Copy this file to .env.prod (gitignored) and fill in real values.
# `compose.prod.yml` reads from .env.prod via `env_file:`.
#
#   cp .env.prod.example .env.prod
#   # edit .env.prod with real secrets
#   docker compose -f compose.prod.yml up --build -d

# ---- Postgres ------------------------------------------------------------
# Used by the db image's docker-entrypoint to bootstrap the cluster on
# first run. Change POSTGRES_PASSWORD for any non-throwaway deployment.
POSTGRES_USER=openfoodledger
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=openfoodledger

# ---- API -----------------------------------------------------------------
# Connection string the FastAPI app uses. Username/password/database here
# MUST match the POSTGRES_* values above.
DATABASE_URL=postgresql+psycopg://openfoodledger:change-me-please@db:5432/openfoodledger

# CORS — narrow this to your real frontend domain(s); comma-separated for
# multiple. Avoid "*" in any deployment that is reachable from the internet.
ALLOWED_ORIGINS=https://app.example.com

# ---- MCP server ----------------------------------------------------------
# The browser-facing URL of the MCP server. Remote MCP connectors
# (ChatGPT custom connector, Claude.ai connector, etc.) discover OAuth
# endpoints relative to this URL, so it MUST match what the user types
# into their connector. HTTPS is required by remote connectors.
MCP_PUBLIC_URL=https://mcp.example.com
